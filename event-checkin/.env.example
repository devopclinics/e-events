# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Hub credentials ────────────────────────────────────────────────────
# Create a personal access token at:
#   https://hub.docker.com/settings/security → "New Access Token"
# Use the token as DOCKER_PASSWORD (safer than your account password).
DOCKER_USERNAME=your_dockerhub_username
DOCKER_PASSWORD=your_dockerhub_access_token

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change_me_use_a_strong_password
# dashboard-service's read-only DB role password. This file (not backend/.env)
# is what docker-compose's own ${DASHBOARD_RO_DB_PASSWORD} interpolation
# reads — env_file: entries in backend/.env are only injected into the
# backend container's env, they never reach Compose's YAML interpolation.
# Must match dashboard_ro_db_password in backend/.env exactly.
DASHBOARD_RO_DB_PASSWORD=change_me_use_a_strong_password

# ── Backup job ────────────────────────────────────────────────────────────────
# UID/GID of the host user that owns the ./backups directory.
# Run: id -u && id -g   to find your values.
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_RETENTION_DAYS=14

# ── Pipeline settings ─────────────────────────────────────────────────────────
# How many versioned tags to keep per service on Docker Hub.
# Tags beyond this count are deleted during each deploy.
KEEP_VERSIONS=3

# ── Paid ticketing (Compose staging only) ────────────────────────────────────
# Master kill switch. false hides navigation/checkout and public APIs return 404.
TICKETING_ENABLED=false
TICKETING_DB_PASSWORD=change_me_use_a_strong_password
# Prefer a dedicated secret. If omitted, Compose falls back to the staging
# planner service secret; never use either value in Kubernetes production.
TICKETING_INTERNAL_SERVICE_TOKEN=change_me_at_least_32_random_characters
TICKETING_STRIPE_TEST_SECRET_KEY=sk_test_replace_me
TICKETING_STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
TICKETING_PAYSTACK_TEST_SECRET_KEY=sk_test_replace_me
# Paystack signs webhooks with its API secret; set this to the same test secret.
TICKETING_PAYSTACK_TEST_WEBHOOK_SECRET=sk_test_replace_me
TICKETING_PLATFORM_FEE_BPS=500
