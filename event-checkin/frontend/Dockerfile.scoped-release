# Used only by the manually dispatched scoped release. No .npmrc or dotenv input.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
# The existing lock pins Firebase 10 with a Capacitor optional Firebase 11 peer.
# Preserve that reviewed lock graph explicitly, without reading any .npmrc.
RUN npm ci --ignore-scripts --legacy-peer-deps --userconfig=/dev/null
COPY . .

# Only public Firebase web configuration is accepted from repository variables.
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
# Not build args: this release cannot opt into public sales chat.
ENV VITE_SALES_CHAT_ENABLED=false \
    VITE_SALES_CHAT_INBOX_VALIDATED=false \
    VITE_EVENT_WEBSITES_ENABLED=true \
    VITE_GUIDED_SETUP_ENABLED=false
RUN node -e 'for (const key of ["API_KEY", "AUTH_DOMAIN", "PROJECT_ID", "STORAGE_BUCKET", "MESSAGING_SENDER_ID", "APP_ID"]) { const value = process.env["VITE_FIREBASE_" + key]; if (!value || /[\s\x00-\x1f]/.test(value)) throw new Error("Missing or invalid public Firebase config: " + key); }'
RUN npm run build

FROM nginx:1.25-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
